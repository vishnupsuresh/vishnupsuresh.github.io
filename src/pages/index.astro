---
// Home page: hero, about, education, experience, projects, skills, leadership.
// Experience and leadership live here as plain data arrays rather than a
// content collection: they're short and rarely change, so separate files
// would add overhead without benefit.
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
// First project with an image is featured large; the rest are list rows.
const lead = projects.find((p) => p.data.image);
const rest = projects.filter((p) => p !== lead).slice(0, 3);

const GITHUB = "https://github.com/vishnupsuresh";
const LINKEDIN = "https://www.linkedin.com/in/vishnu-suresh-08b8b5284";

// Skills grouped by area, matching the resume so the two never disagree.
const skills = [
  { group: "Languages", items: ["Python", "C", "C++", "JavaScript", "HTML", "Java", "SystemVerilog"] },
  { group: "Data & ML", items: ["TensorFlow", "PyTorch", "Pandas", "NumPy", "Streamlit", "Snowflake", "MS SQL Server", "Power BI", "Excel"] },
  { group: "Systems", items: ["Git", "Linux", "GTKWave", "Raspberry Pi", "Arduino", "ServiceNow"] },
  { group: "IT & Support", items: ["Microsoft Intune", "SCCM / MDT", "Windows", "Microsoft 365"] },
];

const courses = [
  "Computer Architecture",
  "Digital Logic Design",
  "Data Structures & Algorithms",
  "Procedural Programming",
  "Introduction to Computer Science",
  "Agentic Coding (Sophomore Projects)",
  "Linear Algebra",
  "Probability",
  "Calculus I & II",
  "Vector Calculus",
];
const EMAIL = "vishnups0001@gmail.com";

const experience = [
  {
    role: "College Aide, IT Operations",
    org: "NYC Department of Youth and Community Development",
    dates: "Jan 2026 – Present",
    points: [
      "Built an Excel inventory tracker for 700+ laptops, desktops, phones, and monitors across 300+ employees, cutting device lookups from 15 minutes to 1 minute.",
      "Resolved 500+ ServiceNow tickets on device compliance, provisioning, and authentication across Intune/MDM, Windows Hello for Business, and SCCM/MDT.",
      "Imaged and deployed 100+ laptops and desktops to enterprise compliance standards.",
    ],
  },
  {
    role: "Instructor",
    org: "Mathnasium Learning Center",
    dates: "Jul 2024 – Aug 2025",
    points: [
      "Taught structured math problem-solving to 40+ students in grades K–12.",
      "Assessed skill gaps with diagnostic tests and tracked individualized learning plans; 89% of students advanced a grade level in 6 months.",
    ],
  },
];

const leadership = [
  { title: "IEEE Student Branch", role: "Board Member" },
  { title: "Cooper OPS", role: "Instructor", note: "Co-teach technical sessions, including one on number systems." },
  { title: "Cooper Union Hoops", role: "Founder" },
  { title: "ACM Student Chapter", role: "Founder (in progress)", note: "Starting Cooper Union's first ACM chapter." },
];
---
<Base>
  <header class="hero">
    <!-- Decorative dot grid, faded at the edges with a mask; hidden from screen readers -->
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="status"><span class="dot" aria-hidden="true"></span>Open to Summer 2027 internships</p>
      <h1 class="hero-name">Vishnu Suresh</h1>
      <p class="hero-line">
        Computer Science student at The Cooper Union. I build hardware and train
        machine learning models.
      </p>
      <dl class="hero-meta">
        <div><dt>Degree</dt><dd>B.S. Computer Science</dd></div>
        <div><dt>Graduating</dt><dd>May 2029</dd></div>
        <div><dt>Based in</dt><dd>New York</dd></div>
      </dl>
      <div class="hero-links">
        <a class="btn btn-primary" href="/resume.pdf" target="_blank" rel="noopener">View resume</a>
        <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        <a class="btn" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={`mailto:${EMAIL}`}>Email</a>
      </div>
    </div>
  </header>

  <section class="section">
    <h2>About</h2>
    <div class="section-body">
      <p>
        I work across hardware, machine learning, and enterprise IT. I've designed a pipelined 32-bit CPU in
        SystemVerilog, trained a CNN that detects brain disorders from EEG data at 85% accuracy, and support
        700+ devices for a New York City agency. I'm looking for Summer 2027 internships in software, data, and ML.
      </p>
      <p class="para">
        Outside of class, I play basketball, tennis, and bowling. I founded Cooper Union Hoops, the school's
        basketball club.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Education</h2>
    <div class="section-body">
      <div class="entry-head">
        <h3>The Cooper Union</h3>
        <span class="muted date">Expected May 2029</span>
      </div>
      <p>B.S. in Computer Science, GPA 3.46</p>
      <p class="tech">Coursework: {courses.join(", ")}</p>
    </div>
  </section>

  <section class="section">
    <h2>Experience</h2>
    <ol class="section-body timeline">
      {experience.map((e) => (
        <li>
          <div class="entry-head">
            <h3>{e.role}</h3>
            <span class="muted date">{e.dates}</span>
          </div>
          <p class="muted">{e.org}</p>
          <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <h2>Projects</h2>
    <div class="section-body stack">
      {lead && <FeaturedProject id={lead.id} {...lead.data} image={lead.data.image!} />}
      {rest.map((p) => <ProjectCard id={p.id} {...p.data} />)}
      <p><a href="/projects/">See all projects</a></p>
    </div>
  </section>

  <section class="section">
    <h2>Skills</h2>
    <dl class="section-body skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(", ")}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section">
    <h2>Leadership</h2>
    <div class="section-body stack-tight">
      {leadership.map((l) => (
        <div>
          <h3>{l.title}</h3>
          <p class="muted">{l.role}{l.note && `. ${l.note}`}</p>
        </div>
      ))}
    </div>
  </section>

</Base>

<style>
  /* Hero: the name is the loudest type on the site, set in Archivo's widest cut */
  /* overflow: clip keeps the grid's bleed from widening the page on phones */
  .hero { position: relative; padding: 4.5rem 0 3.5rem; overflow: clip; }
  .hero-content { position: relative; }   /* sits above the grid */

  /* Graph-paper dots that fade out toward the bottom-right */
  .hero-grid {
    position: absolute; inset: 0 -1.5rem;
    background-image: radial-gradient(color-mix(in srgb, var(--graphite) 45%, transparent) 1.2px, transparent 1.3px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 15% 30%, #000 30%, transparent 75%);
            mask-image: radial-gradient(ellipse 80% 90% at 15% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .status {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.88rem; font-weight: 550;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--card);
    margin-bottom: 1.5rem;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--trace); box-shadow: 0 0 0 3px color-mix(in srgb, var(--trace) 22%, transparent); }
  .hero-name {
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 820;
    font-variation-settings: "wdth" 125;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-line { margin-top: 1.25rem; max-width: 34em; font-size: 1.2rem; color: var(--graphite); }
  /* Degree / graduation / location as a compact fact row */
  .hero-meta { display: flex; flex-wrap: wrap; gap: 0.75rem 2.5rem; margin: 1.75rem 0 0; }
  .hero-meta dt { font-size: 0.8rem; color: var(--graphite); }
  .hero-meta dd { margin: 0.1rem 0 0; font-weight: 620; }

  .hero-links { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 2rem; }
  .btn {
    display: inline-block; padding: 0.55rem 1.1rem;
    border: 1px solid var(--rule); border-radius: 6px;
    background: var(--card); color: var(--ink);
    font-weight: 560; font-size: 0.95rem; text-decoration: none;
    transition: border-color 150ms, background 150ms;
  }
  .btn:hover { border-color: var(--ink); text-decoration: none; }
  .btn-primary { background: var(--trace); border-color: var(--trace); color: var(--on-trace); }
  .btn-primary:hover { border-color: var(--trace); filter: brightness(1.1); }

  /* Experience timeline: vertical rule with a dot per job (jobs are a real sequence) */
  .timeline { list-style: none; margin: 0; padding: 0 0 0 1.5rem; border-left: 2px solid var(--rule); }
  .timeline > li { position: relative; }
  .timeline > li + li { margin-top: 2.25rem; }
  .timeline > li::before {
    content: ""; position: absolute; left: calc(-1.5rem - 7px); top: 0.4rem;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--paper); border: 2px solid var(--trace);
  }
  .timeline > li:first-child::before { background: var(--trace); }   /* filled = current job */

  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .date { font-size: 0.88rem; white-space: nowrap; }
  .points { margin: 0.6rem 0 0; padding-left: 1.1rem; }
  .points li + li { margin-top: 0.35rem; }

  .stack-tight > * + * { margin-top: 1.1rem; }
  .para { margin-top: 1rem; }

  /* Skills as a definition list: label column + comma list, no pill chips */
  .skills { margin: 0; }
  .skills > div { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid var(--rule); }
  .skills > div:first-child { padding-top: 0; }
  .skills dt { font-weight: 620; }
  .skills dd { margin: 0; color: var(--graphite); }
  @media (max-width: 520px) { .skills > div { grid-template-columns: 1fr; gap: 0.15rem; } }
</style>

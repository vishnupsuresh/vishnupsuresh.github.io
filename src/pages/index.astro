---
// Home page: about, experience, featured projects, leadership, contact.
// Experience and leadership live here as plain data arrays rather than a
// content collection: they're short and rarely change, so separate files
// would add overhead without benefit.
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = projects.slice(0, 4);

const GITHUB = "https://github.com/vishnupsuresh";
const LINKEDIN = "https://www.linkedin.com/in/vishnu-suresh-08b8b5284";

// Skills grouped by area, matching the resume so the two never disagree.
const skills = [
  { group: "Languages", items: ["Python", "C++", "C", "Java", "SystemVerilog", "HTML"] },
  { group: "Data & ML", items: ["TensorFlow", "PyTorch", "Pandas", "NumPy", "Streamlit", "Snowflake", "MS SQL Server", "Power BI", "Excel"] },
  { group: "Systems", items: ["Git", "Linux", "GTKWave", "Raspberry Pi", "Arduino", "ServiceNow"] },
  { group: "IT & Support", items: ["Microsoft Intune", "SCCM / MDT", "Windows", "Microsoft 365"] },
];

const courses = [
  "Data Structures & Algorithms (C++)",
  "Computer Architecture",
  "ECE 160 (C)",
  "CS 101 (Python)",
  "Linear Algebra",
  "Probability & Statistics",
];
const EMAIL = "vishnups0001@gmail.com";

const experience = [
  {
    role: "College Aide, IT Operations",
    org: "NYC Department of Youth and Community Development",
    dates: "Jan 2026 – Present",
    points: [
      "Built an Excel inventory tracker for 700+ laptops, desktops, phones, and monitors across 300+ employees, cutting device lookups from 15 minutes to 1 minute.",
      "Resolved 500+ ServiceNow tickets on device compliance, provisioning, and authentication across Intune/MDM, Windows Hello for Business, and SCCM/MDT.",
      "Imaged and deployed 100+ laptops and desktops to enterprise compliance standards.",
    ],
  },
  {
    role: "Instructor",
    org: "Mathnasium Learning Center",
    dates: "Jul 2024 – Aug 2025",
    points: [
      "Taught structured math problem-solving to 40+ students in grades K–12.",
      "Assessed skill gaps with diagnostic tests and tracked individualized learning plans; 89% of students advanced a grade level in 6 months.",
    ],
  },
];

const leadership = [
  { title: "IEEE Student Branch", role: "Board Member" },
  { title: "Cooper OPS", role: "Instructor", note: "Co-teach technical sessions, including one on number systems." },
  { title: "Cooper Union Hoops", role: "Founder" },
  { title: "ACM Student Chapter", role: "Founder (in progress)", note: "Starting Cooper Union's first ACM chapter." },
];
---
<Base>
  <header>
    <h1>Vishnu Suresh</h1>
    <p class="tagline">Computer Science @ The Cooper Union · New York</p>
    <div class="links">
      <a class="btn" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
      <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={`mailto:${EMAIL}`}>Email</a>
    </div>
  </header>

  <section>
    <h2>About</h2>
    <p>
      I'm a Computer Science undergraduate at The Cooper Union. I work across hardware, machine learning,
      and enterprise IT: I've designed a pipelined 32-bit CPU in SystemVerilog, trained a CNN that detects brain disorders from EEG
      data at 85% accuracy, and manage devices for a New York City agency. I'm looking for Summer 2027 internships
      in software, data, and ML.
    </p>
  </section>

  <section>
    <h2>Education</h2>
    <div class="item">
      <div class="item-head">
        <h3>The Cooper Union · B.S. in Computer Science</h3>
        <span class="meta">Expected May 2029</span>
      </div>
      <p><span class="muted">GPA:</span> 3.46</p>
      <p><span class="muted">Relevant coursework:</span> {courses.join(" · ")}</p>
    </div>
  </section>

  <section>
    <h2>Experience</h2>
    {experience.map((e) => (
      <div class="item">
        <div class="item-head">
          <h3>{e.role} · {e.org}</h3>
          <span class="meta">{e.dates}</span>
        </div>
        <ul>{e.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Projects</h2>
    <div class="cards">
      {featured.map((p) => <ProjectCard id={p.id} {...p.data} />)}
    </div>
    <p><a href="/projects/">All projects →</a></p>
  </section>

  <section>
    <h2>Skills</h2>
    {skills.map((s) => (
      <div class="skill-row">
        <span class="skill-group">{s.group}</span>
        <div class="tags">{s.items.map((i) => <span class="tag">{i}</span>)}</div>
      </div>
    ))}
  </section>

  <section>
    <h2>Leadership</h2>
    {leadership.map((l) => (
      <div class="item">
        <h3>{l.title} · {l.role}</h3>
        {l.note && <p>{l.note}</p>}
      </div>
    ))}
  </section>

  <section>
    <h2>Contact</h2>
    <p>Email <a href={`mailto:${EMAIL}`}>{EMAIL}</a> or reach out on <a href={LINKEDIN}>LinkedIn</a>.</p>
  </section>
</Base>

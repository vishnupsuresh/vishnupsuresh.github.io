---
// Reusable card: used on both the home page and the /projects/ index,
// so the two lists never drift apart in style.
interface Props {
  id: string;
  title: string;
  summary: string;
  tags: string[];
}
const { id, title, summary, tags } = Astro.props;
---
<a class="card" href={`/projects/${id}/`}>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
</a>

---
// Large block for the lead project on the home page: image on top, text below.
// Only used for a project whose frontmatter has `image`; others use ProjectCard rows.
interface Props {
  id: string;
  title: string;
  summary: string;
  date?: string;
  tags: string[];
  image: string;
  imageAlt?: string;
}
const { id, title, summary, date, tags, image, imageAlt = "" } = Astro.props;
---
<a class="feat" href={`/projects/${id}/`}>
  <div class="feat-img">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>
  <div class="feat-text">
    <div class="feat-head">
      <h3>{title}</h3>
      {date && <span class="feat-date">{date}</span>}
    </div>
    <p>{summary}</p>
    <p class="tech">{tags.join(", ")}</p>
    <span class="feat-cta">Read the write-up</span>
  </div>
</a>

<style>
  /* Whole block is one link, so the image is clickable too */
  .feat {
    display: block;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
    background: var(--card);
    transition: border-color 150ms;
  }
  .feat:hover { border-color: var(--trace); text-decoration: none; }
  .feat:hover .feat-cta { text-decoration-thickness: 2px; }

  /* Fixed aspect ratio crops the screenshot to its most informative top area */
  .feat-img { aspect-ratio: 16 / 7; overflow: hidden; border-bottom: 1px solid var(--rule); background: #fff; }
  .feat-img img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }

  .feat-text { padding: 1.25rem 1.4rem 1.4rem; }
  .feat-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .feat h3 { font-size: 1.3rem; }
  .feat-date { color: var(--graphite); font-size: 0.88rem; white-space: nowrap; }
  .feat-text > p:first-of-type { margin-top: 0.4rem; }
  .feat-cta {
    display: inline-block; margin-top: 0.9rem;
    color: var(--trace); font-weight: 600;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px;
  }
</style>

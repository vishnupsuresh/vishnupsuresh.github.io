---
// Shared layout: every page wraps its content in this.
// Keeping nav, footer, and CSS here means one edit updates the whole site.
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Vishnu Suresh",
  description = "Vishnu Suresh: Computer Science at The Cooper Union.",
} = Astro.props;

// Highlight the active nav link by comparing against the current path.
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume.pdf", label: "Resume" },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- TODO: add public/og.png (1200x630) and uncomment for link previews -->
    <!-- <meta property="og:image" content={new URL("/og.png", Astro.site)} /> -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <nav>
      <div class="inner">
        <a class="name" href="/">Vishnu Suresh</a>
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href} class={path === n.href ? "active" : ""}>{n.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} Vishnu Suresh</footer>
  </body>
</html>

<!--
  is:global applies these styles site-wide. Astro scopes <style> to the component
  by default, which would stop them reaching page content passed through <slot />.
-->
<style is:global>
  :root {
    --bg: #fbfbf9; --text: #1d1d1b; --muted: #5f5f5a;
    --line: #e3e2dc; --accent: #1f5fbf; --card: #ffffff; --max: 760px;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414; --text: #ececea; --muted: #a3a39e;
      --line: #2c2c2a; --accent: #7aa7ff; --card: #1b1b1a;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text); line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  nav { position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid var(--line); z-index: 10; }
  nav .inner {
    max-width: var(--max); margin: 0 auto; padding: 0.8rem 1.25rem;
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
  }
  nav .name { font-weight: 600; color: var(--text); }
  nav ul { list-style: none; display: flex; gap: 1.1rem; margin: 0; padding: 0; }
  nav ul a { color: var(--muted); }
  nav ul a.active { color: var(--text); font-weight: 600; }

  main { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem 4rem; }
  section { padding-top: 2.5rem; }
  h1 { font-size: 2.2rem; margin: 3rem 0 0.25rem; line-height: 1.2; }
  h2 { font-size: 1.3rem; margin: 0 0 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--line); }
  h3 { font-size: 1.05rem; margin: 0; }
  .muted { color: var(--muted); }
  .tagline { color: var(--muted); margin: 0 0 1.25rem; font-size: 1.1rem; }

  .links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn { border: 1px solid var(--line); background: var(--card); padding: 0.4rem 0.9rem; border-radius: 6px; }

  .item { margin-bottom: 1.6rem; }
  .item-head { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: baseline; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .item p, .item ul { margin: 0.35rem 0 0; }
  .item ul { padding-left: 1.2rem; }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .tag { font-size: 0.78rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 0.1rem 0.6rem; }

  /* Skills: fixed-width label column so the tag rows line up */
  .skill-row { display: grid; grid-template-columns: 110px 1fr; gap: 0.75rem; align-items: start; margin-bottom: 0.6rem; }
  .skill-row .tags { margin-top: 0; }
  .skill-group { font-weight: 600; font-size: 0.93rem; padding-top: 0.1rem; }
  @media (max-width: 500px) { .skill-row { grid-template-columns: 1fr; gap: 0.3rem; } }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .card { display: block; border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: 1rem; color: var(--text); }
  .card:hover { border-color: var(--accent); text-decoration: none; }
  .card p { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.93rem; }

  /* Markdown output on project pages */
  .prose h2 { margin-top: 2rem; }
  .prose code { background: var(--card); border: 1px solid var(--line); padding: 0.1rem 0.3rem; border-radius: 4px; }

  footer { text-align: center; color: var(--muted); font-size: 0.85rem; padding: 2rem 0; border-top: 1px solid var(--line); }
</style>

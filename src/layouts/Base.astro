---
// Shared layout: nav, footer, fonts, and all site-wide CSS.
// Fonts are self-hosted through @fontsource (bundled at build time), so the
// site makes no requests to Google Fonts: faster first paint, no third-party tracking.
import "@fontsource-variable/archivo/wdth.css";        // Archivo with width + weight axes
import "@fontsource-variable/jetbrains-mono";          // used only inside the bit diagram

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Vishnu Suresh",
  description = "Vishnu Suresh: Computer Science at The Cooper Union.",
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/resume.pdf", label: "Resume" },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- TODO: add public/og.png (1200x630) and uncomment for link previews -->
    <!-- <meta property="og:image" content={new URL("/og.png", Astro.site)} /> -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <nav>
      <div class="wrap nav-inner">
        <a class="nav-name" href="/">Vishnu Suresh</a>
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap">
      <div class="foot">
        <span>© {new Date().getFullYear()} Vishnu Suresh</span>
        <span>Built with Astro, hosted on GitHub Pages</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ---------- Tokens ---------- */
  :root {
    --paper: #f4f6f8;
    --ink: #18202c;
    --graphite: #586273;
    --rule: #d6dbe1;
    --bit-off: #e3e7ec;
    --trace: #1f6f55;          /* solder-mask green: the only accent */
    --wrap: 960px;
    --rail: 180px;             /* left column for section headings */
    --sans: "Archivo Variable", system-ui, sans-serif;
    --mono: "JetBrains Mono Variable", ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #11151b;
      --ink: #e4e8ee;
      --graphite: #98a2b3;
      --rule: #2a313b;
      --bit-off: #1f252e;
      --trace: #63c49b;
    }
  }

  /* ---------- Base ---------- */
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;      /* 17px: slightly larger than default for comfortable reading */
    line-height: 1.6;
    font-variation-settings: "wdth" 100;
  }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 1.5rem; }
  a { color: var(--trace); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  /* Visible keyboard focus everywhere */
  :focus-visible { outline: 2px solid var(--trace); outline-offset: 3px; border-radius: 2px; }

  /* Headings use a wider cut of the same family: one typeface, two voices */
  h1, h2, h3 { font-variation-settings: "wdth" 112; line-height: 1.2; margin: 0; }
  h2 { font-size: 1.05rem; font-weight: 650; }
  h3 { font-size: 1.1rem; font-weight: 620; }
  p { margin: 0; }

  /* ---------- Nav ---------- */
  nav { border-bottom: 1px solid var(--rule); }
  .nav-inner { display: flex; justify-content: space-between; align-items: center; height: 60px; }
  .nav-name { color: var(--ink); text-decoration: none; font-weight: 700; font-variation-settings: "wdth" 115; }
  nav ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; }
  nav ul a { color: var(--graphite); text-decoration: none; font-size: 0.95rem; }
  nav ul a:hover, nav ul a[aria-current="page"] { color: var(--ink); }

  /* ---------- Section layout: heading rail + content ---------- */
  .section {
    display: grid;
    /* minmax(0, 1fr): without it, a wide table or code block widens the whole column */
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 2rem;
    padding: 3rem 0;
    border-top: 1px solid var(--rule);
  }
  .section > h2 { padding-top: 0.15rem; }
  .section-body { max-width: 640px; }     /* keeps line length under ~80 characters */

  /* ---------- Shared bits ---------- */
  .muted { color: var(--graphite); }
  .stack > * + * { margin-top: 2rem; }    /* vertical rhythm between entries */
  .tech { color: var(--graphite); font-size: 0.9rem; margin-top: 0.5rem; }

  /* Markdown on project pages */
  .prose h2 { font-size: 1.15rem; margin: 2.25rem 0 0.6rem; }
  .prose p, .prose ul { margin: 0 0 1rem; }
  .prose ul { padding-left: 1.2rem; }
  .prose li + li { margin-top: 0.35rem; }
  .prose code { font-family: var(--mono); font-size: 0.88em; background: var(--bit-off); padding: 0.1rem 0.35rem; border-radius: 3px; }

  /* Code blocks: scroll sideways instead of breaking the layout on phones.
     Astro's syntax highlighter sets its own background; we only fix spacing. */
  .prose pre { font-family: var(--mono); font-size: 0.85rem; line-height: 1.45; padding: 1rem; margin: 0 0 1.25rem; border-radius: 4px; overflow-x: auto; }
  .prose pre code { background: none; padding: 0; font-size: inherit; }

  /* Figures: full column width, caption in the muted color */
  .prose figure { margin: 1.5rem 0 2rem; }
  .prose img { display: block; max-width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 4px; background: #fff; }
  .prose figcaption { margin-top: 0.6rem; font-size: 0.88rem; color: var(--graphite); }

  /* Tables: wrapper-free horizontal scroll so wide tables don't overflow on mobile */
  .prose table { display: block; overflow-x: auto; border-collapse: collapse; margin: 0 0 1.25rem; font-size: 0.92rem; }
  .prose th, .prose td { text-align: left; padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose th { font-weight: 620; }
  .prose td code { white-space: nowrap; }

  /* ---------- Footer ---------- */
  /* Rule lives on the inner div so it lines up with the section rules */
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    color: var(--graphite); font-size: 0.85rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--rule);
  }

  /* ---------- Mobile: rail collapses above content ---------- */
  @media (max-width: 720px) {
    .section { grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 2.25rem 0; }
    nav ul { gap: 1rem; }
  }
  @media (max-width: 420px) {
    .wrap { padding: 0 1.15rem; }
    .nav-name { font-size: 0.95rem; }
    nav ul { gap: 0.85rem; }
    nav ul a { font-size: 0.88rem; }
  }
</style>
